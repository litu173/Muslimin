rules_version = '2';

// Muslimin – Firestore security rules
//
// Roles
//   * Anyone (even signed-out)  : read APPROVED masjids and their notices.
//   * Signed-in account         : email/password; manages its own users/{uid} profile.
//   * Account + verified phone  : create a masjid profile -> always starts as `pending`.
//   * Masjid owner              : edit their own masjid's times/staff/live link and post notices,
//                                 but can never change `status`, `ownerUid` or verification data.
//   * Super admin               : users/{uid}.role == 'superAdmin' (set manually in the console),
//                                 approves / rejects / suspends masjids.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == 'superAdmin';
    }
    function isOwner(masjid) { return signedIn() && masjid.ownerUid == request.auth.uid; }
    function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }

    // Account profiles: name, email, phone, followed masjids, FCM tokens.
    match /users/{uid} {
      function isSelf() { return signedIn() && request.auth.uid == uid; }
      function validProfile() {
        return request.resource.data.keys().hasOnly(
                 ['name', 'email', 'phone', 'role', 'createdAt', 'follows', 'fcmTokens',
                  'editBlocked'])
          && (!('name' in request.resource.data) || request.resource.data.name is string
              && request.resource.data.name.size() <= 80);
      }

      allow read: if isSelf() || isSuperAdmin();
      // Users can create their own profile but never promote themselves.
      allow create: if isSelf() && request.resource.data.role == 'user' && validProfile();
      // `editBlocked` (no volunteering) is set by the admin only.
      allow update: if (isSelf() && unchanged(['role', 'createdAt', 'editBlocked']) && validProfile())
        || isSuperAdmin();
      allow delete: if isSelf() || isSuperAdmin();
    }

    match /masjids/{masjidId} {
      allow read: if resource.data.status == 'approved'
        || isOwner(resource.data)
        || isSuperAdmin();

      // The admin adds masjids users found missing (suggestions below).
      allow create: if isSuperAdmin()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.geo.geopoint is latlng;

      // Rule-set for creating a masjid profile (mirrors the in-app checks).
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        // Verified phone (SMS OTP) – or, during the public beta, a typed BD
        // mobile number that the admin sees flagged as not verified.
        && ((request.resource.data.phoneVerified == true
              && request.resource.data.ownerPhone == request.auth.token.phone_number)
            || (request.resource.data.phoneVerified == false
              && request.resource.data.ownerPhone.matches('^[+]8801[3-9][0-9]{8}$')))
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 80
        && request.resource.data.nid.matches('^[0-9]{10}$|^[0-9]{13}$|^[0-9]{17}$')
        && request.resource.data.agreedToTerms == true
        // GPS fix within 50 m, or a pin placed on the map (stored as 0 m).
        && request.resource.data.locationAccuracyM <= 50
        && request.resource.data.get('locationSource', 'gps') in ['gps', 'map']
        && request.resource.data.geo.geopoint is latlng;

      // Owners maintain day-to-day info; status & verification fields are locked.
      allow update: if (isOwner(resource.data)
          && resource.data.status in ['approved', 'pending']
          && unchanged(['status', 'ownerUid', 'ownerPhone', 'phoneVerified', 'nid',
                        'reviewedBy', 'reviewedAt', 'rejectionReason', 'createdAt'])
          // The location may be re-captured with an accurate GPS fix or
          // re-pinned on the map (Edit masjid info).
          && request.resource.data.get('locationSource', 'gps') in ['gps', 'map']
          && (unchanged(['geo', 'locationAccuracyM'])
            || (request.resource.data.locationAccuracyM <= 50
              && request.resource.data.geo.geopoint is latlng)))
        || isSuperAdmin()
        // Volunteer editors (people near the masjid): jamat times, maktab
        // and staff only, signed with their uid.
        || (isEditor()
          && resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['jamat', 'jamatUpdatedAt', 'hasJamat', 'maktab', 'staff',
                'updatedBy', 'updatedByName', 'updatedAt'])
          && request.resource.data.updatedBy == request.auth.uid);

      allow delete: if isSuperAdmin();

      function isEditor() {
        return signedIn() && exists(/databases/$(database)/documents/masjids/$(masjidId)/editors/$(request.auth.uid));
      }
      function editBlocked() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('editBlocked', false) == true;
      }

      // ---- Volunteer editors: anyone standing within ~2 km of an approved
      // masjid may keep its times up to date. The app measures a fresh GPS
      // fix; the rules check the stated position is near the masjid.
      match /editors/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid
          || masjidDoc().ownerUid == request.auth.uid || isSuperAdmin());
        // The admin makes whoever suggested a masjid its first editor.
        allow create: if isSuperAdmin();
        allow create: if signedIn() && request.auth.uid == uid
          && masjidDoc().status == 'approved'
          && !editBlocked()
          && request.resource.data.keys().hasOnly(
               ['uid', 'name', 'masjidId', 'masjidName', 'lat', 'lng', 'distanceM', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.masjidId == masjidId
          && request.resource.data.lat is number
          && request.resource.data.lng is number
          && math.abs(request.resource.data.lat - masjidDoc().geo.geopoint.latitude()) < 0.025
          && math.abs(request.resource.data.lng - masjidDoc().geo.geopoint.longitude()) < 0.025;
        allow delete: if signedIn() && (request.auth.uid == uid
          || masjidDoc().ownerUid == request.auth.uid || isSuperAdmin());
      }

      // ---- Edit history: who changed times / staff / maktab, before and
      // after. Written with the change; read by the owner and the admin.
      match /edits/{editId} {
        allow read: if signedIn() && (masjidDoc().ownerUid == request.auth.uid || isSuperAdmin());
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.masjidId == masjidId
          && request.resource.data.field in ['jamat', 'staff', 'maktab']
          && (masjidDoc().ownerUid == request.auth.uid || isEditor() || isSuperAdmin());
      }

      // ---- Channel: the masjid's Imam / Khatib / committee message the
      // people who joined. Only members read; editors and admins post;
      // admins (and the masjid's owner) manage roles.
      function masjidDoc() { return get(/databases/$(database)/documents/masjids/$(masjidId)).data; }
      function myMember() { return /databases/$(database)/documents/masjids/$(masjidId)/members/$(request.auth.uid); }
      function channelRole() {
        return signedIn() && exists(myMember()) ? get(myMember()).data.role : '';
      }
      function isChannelAdmin() {
        return signedIn() && (masjidDoc().ownerUid == request.auth.uid
          || channelRole() == 'admin' || isSuperAdmin());
      }
      function canPost() { return isChannelAdmin() || channelRole() == 'editor'; }

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isChannelAdmin());
        // Join yourself, as a plain member, an approved masjid's channel.
        allow create: if signedIn() && request.auth.uid == uid
          && masjidDoc().status == 'approved'
          && request.resource.data.keys().hasOnly(
               ['uid', 'masjidId', 'masjidName', 'name', 'role', 'joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.masjidId == masjidId
          && request.resource.data.role == 'member';
        // Only the role changes, and only by an admin.
        allow update: if isChannelAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['member', 'editor', 'admin'];
        // Leave yourself, or be removed by an admin.
        allow delete: if signedIn() && (request.auth.uid == uid || isChannelAdmin());
      }

      match /messages/{messageId} {
        allow read: if isChannelAdmin() || channelRole() != '';
        allow create: if canPost()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.masjidId == masjidId
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          // Text, an attachment, or both.
          && (request.resource.data.text.size() > 0
              || request.resource.data.get('attachment', null) != null);
        allow delete: if isChannelAdmin()
          || (signedIn() && resource.data.authorUid == request.auth.uid);

        // Attachment bytes, ~900 KB per chunk (no paid file storage).
        match /chunks/{i} {
          allow read: if isChannelAdmin() || channelRole() != '';
          allow create: if canPost()
            && request.resource.data.keys().hasOnly(['b'])
            && request.resource.data.b is bytes
            && request.resource.data.b.size() <= 1000000;
          allow delete: if canPost();
        }
      }
    }

    // Admin report: every edit and every editor, across masjids.
    match /{path=**}/edits/{editId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/editors/{uid} {
      allow read: if isSuperAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Masjids missing from the app, pinned by users; the admin adds them.
    match /suggestions/{id} {
      allow read: if isSuperAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['name', 'nameBn', 'lat', 'lng', 'district', 'thana', 'uid', 'userName',
              'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 80
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
      allow update, delete: if isSuperAdmin();
    }

    // Problems reported by users ("wrong jamat time"…): one per user and
    // masjid (id = masjidId_uid); only the admin reads and resolves them.
    match /reports/{reportId} {
      function validReport() {
        return signedIn()
          && reportId == request.resource.data.masjidId + '_' + request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.keys().hasOnly(
               ['masjidId', 'masjidName', 'district', 'uid', 'userName', 'reason',
                'note', 'status', 'createdAt'])
          && request.resource.data.reason in
               ['wrongTime', 'wrongLocation', 'wrongInfo', 'closed', 'duplicate', 'other']
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500;
      }
      allow read: if isSuperAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if validReport();
      // Reporting again replaces your own report (and reopens it).
      allow update: if validReport() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // "My channels": a user can list their own memberships across masjids.
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /notices/{noticeId} {
      function masjid(id) { return get(/databases/$(database)/documents/masjids/$(id)).data; }

      allow read: if true;
      allow create: if signedIn()
        && masjid(request.resource.data.masjidId).ownerUid == request.auth.uid
        && masjid(request.resource.data.masjidId).status == 'approved'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      allow update, delete: if (signedIn()
          && masjid(resource.data.masjidId).ownerUid == request.auth.uid)
        || isSuperAdmin();
    }
  }
}
