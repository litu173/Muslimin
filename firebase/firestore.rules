rules_version = '2';

// Muslimin – Firestore security rules
//
// Roles
//   * Anyone (even signed-out)  : read APPROVED masjids and their notices.
//   * Signed-in account         : email/password; manages its own users/{uid} profile.
//   * Account + verified phone  : create a masjid profile -> always starts as `pending`.
//   * Masjid owner              : edit their own masjid's times/staff/live link and post notices,
//                                 but can never change `status`, `ownerUid` or verification data.
//   * Admin / super admin       : users/{uid}.role 'admin' / 'superAdmin' – approve, reject,
//                                 suspend masjids; see role() below for every role.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    // Roles (users/{uid}.role, set by the super admin in the admin website):
    //   superAdmin – everything, incl. roles and app settings
    //   admin      – moderation: masjids, review, users, notifications
    //   editor     – edits times / maktab / staff / location of any masjid
    //   volunteer  – may volunteer for any masjid (no 2 km check)
    //   user       – everyone else
    function role() {
      return signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userDoc().data.get('role', 'user') : '';
    }
    function isSuperAdmin() { return role() == 'superAdmin'; }
    function isAdmin() { return role() in ['admin', 'superAdmin']; }
    function isGlobalEditor() { return role() in ['editor', 'admin', 'superAdmin']; }
    function isTrustedVolunteer() { return role() == 'volunteer'; }
    function isOwner(masjid) { return signedIn() && masjid.ownerUid == request.auth.uid; }
    function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }

    // Account profiles: name, email, phone, followed masjids, FCM tokens.
    match /users/{uid} {
      function isSelf() { return signedIn() && request.auth.uid == uid; }
      function validProfile() {
        return request.resource.data.keys().hasOnly(
                 ['name', 'email', 'phone', 'role', 'createdAt', 'follows', 'fcmTokens',
                  'editBlocked', 'disabled', 'lastSeenAt', 'appVersion', 'platform'])
          && (!('name' in request.resource.data) || request.resource.data.name is string
              && request.resource.data.name.size() <= 80);
      }

      allow read: if isSelf() || isAdmin();
      // Users can create their own profile but never promote themselves.
      allow create: if isSelf() && request.resource.data.role == 'user' && validProfile();
      // `editBlocked` (no volunteering) and `disabled` are set by the admin only.
      allow update: if (isSelf() && unchanged(['role', 'createdAt', 'editBlocked', 'disabled'])
          && validProfile())
        || isSuperAdmin()
        || (isAdmin() && unchanged(['role'])
          && !(resource.data.get('role', 'user') in ['admin', 'superAdmin']));
      allow delete: if isSelf() || isSuperAdmin();

      // Messages the admin sent to this user (Notifications page).
      match /inbox/{messageId} {
        allow read, delete: if isSelf() || isAdmin();
        allow create: if isAdmin();
      }
    }

    match /masjids/{masjidId} {
      allow read: if resource.data.status == 'approved'
        || isOwner(resource.data)
        || isAdmin();

      // The admin adds masjids users found missing (suggestions below).
      allow create: if isAdmin()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.geo.geopoint is latlng;

      // Rule-set for creating a masjid profile (mirrors the in-app checks).
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        // Verified phone (SMS OTP) – or, during the public beta, a typed
        // mobile number that the admin sees flagged as not verified: a BD
        // mobile in Bangladesh, any international number elsewhere.
        && ((request.resource.data.phoneVerified == true
              && request.resource.data.ownerPhone == request.auth.token.phone_number)
            || (request.resource.data.phoneVerified == false
              && (request.resource.data.ownerPhone.matches('^[+]8801[3-9][0-9]{8}$')
                || (abroad() && request.resource.data.ownerPhone.matches('^[+][1-9][0-9]{7,14}$')))))
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 80
        // The Bangladesh NID; elsewhere an optional ID of any kind.
        && (request.resource.data.nid.matches('^[0-9]{10}$|^[0-9]{13}$|^[0-9]{17}$')
          || (abroad() && request.resource.data.nid is string && request.resource.data.nid.size() <= 30))
        && request.resource.data.agreedToTerms == true
        // GPS fix within 50 m, or a pin placed on the map (stored as 0 m).
        && request.resource.data.locationAccuracyM <= 50
        && request.resource.data.get('locationSource', 'gps') in ['gps', 'map']
        && request.resource.data.geo.geopoint is latlng;

      // Owners maintain day-to-day info; status & verification fields are locked.
      allow update: if (isOwner(resource.data)
          && resource.data.status in ['approved', 'pending']
          && unchanged(['status', 'ownerUid', 'ownerPhone', 'phoneVerified', 'nid',
                        'reviewedBy', 'reviewedAt', 'rejectionReason', 'createdAt'])
          // The location may be re-captured with an accurate GPS fix or
          // re-pinned on the map (Edit masjid info).
          && request.resource.data.get('locationSource', 'gps') in ['gps', 'map']
          && (unchanged(['geo', 'locationAccuracyM'])
            || (request.resource.data.locationAccuracyM <= 50
              && request.resource.data.geo.geopoint is latlng)))
        || isAdmin()
        // Editors (role): times, maktab, staff and location of any
        // approved masjid, signed with their uid.
        || (isGlobalEditor()
          && resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['jamat', 'jamatUpdatedAt', 'hasJamat', 'maktab', 'staff',
                'geo', 'locationSource', 'locationAccuracyM', 'district', 'thana', 'country',
                'updatedBy', 'updatedByName', 'updatedAt'])
          && request.resource.data.updatedBy == request.auth.uid)
        // Volunteer editors (people near the masjid): jamat times, maktab
        // and staff only, signed with their uid.
        || (isEditor()
          && resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['jamat', 'jamatUpdatedAt', 'hasJamat', 'maktab', 'staff',
                'geo', 'locationSource', 'locationAccuracyM', 'district', 'thana', 'country',
                'updatedBy', 'updatedByName', 'updatedAt'])
          && request.resource.data.updatedBy == request.auth.uid
          // A wrong pin may be moved, but only nearby (~2 km).
          && (unchanged(['geo'])
            || (request.resource.data.geo.geopoint is latlng
              && math.abs(request.resource.data.geo.geopoint.latitude()
                   - resource.data.geo.geopoint.latitude()) < 0.02
              && math.abs(request.resource.data.geo.geopoint.longitude()
                   - resource.data.geo.geopoint.longitude()) < 0.02)));

      allow delete: if isAdmin();

      // A masjid outside Bangladesh (no `country` = Bangladesh).
      function abroad() {
        return request.resource.data.get('country', 'BD') is string
          && request.resource.data.get('country', 'BD') != 'BD';
      }

      function isEditor() {
        return signedIn() && exists(/databases/$(database)/documents/masjids/$(masjidId)/editors/$(request.auth.uid));
      }
      function editBlocked() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('editBlocked', false) == true;
      }

      // ---- Volunteer editors: anyone standing within ~2 km of an approved
      // masjid may keep its times up to date. The app measures a fresh GPS
      // fix; the rules check the stated position is near the masjid.
      match /editors/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid
          || masjidDoc().ownerUid == request.auth.uid || isAdmin());
        // The admin makes whoever suggested a masjid its first editor.
        allow create: if isAdmin();
        allow create: if signedIn() && request.auth.uid == uid
          && masjidDoc().status == 'approved'
          && !editBlocked()
          && request.resource.data.keys().hasOnly(
               ['uid', 'name', 'masjidId', 'masjidName', 'lat', 'lng', 'distanceM', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.masjidId == masjidId
          && request.resource.data.lat is number
          && request.resource.data.lng is number
          // Volunteers (role) may help any masjid; others must be nearby.
          && (isTrustedVolunteer()
            || (math.abs(request.resource.data.lat - masjidDoc().geo.geopoint.latitude()) < 0.025
              && math.abs(request.resource.data.lng - masjidDoc().geo.geopoint.longitude()) < 0.025));
        allow delete: if signedIn() && (request.auth.uid == uid
          || masjidDoc().ownerUid == request.auth.uid || isAdmin());
      }

      // ---- Edit history: who changed times / staff / maktab, before and
      // after. Written with the change; read by the owner and the admin.
      match /edits/{editId} {
        allow read: if signedIn() && (masjidDoc().ownerUid == request.auth.uid || isAdmin());
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.masjidId == masjidId
          && request.resource.data.field in ['jamat', 'staff', 'maktab', 'location']
          && (masjidDoc().ownerUid == request.auth.uid || isEditor() || isGlobalEditor());
        // Removed only with the masjid itself.
        allow delete: if isAdmin();
      }

      // ---- Channel: the masjid's Imam / Khatib / committee message the
      // people who joined. Only members read; editors and admins post;
      // admins (and the masjid's owner) manage roles.
      function masjidDoc() { return get(/databases/$(database)/documents/masjids/$(masjidId)).data; }
      function myMember() { return /databases/$(database)/documents/masjids/$(masjidId)/members/$(request.auth.uid); }
      function channelRole() {
        return signedIn() && exists(myMember()) ? get(myMember()).data.role : '';
      }
      function isChannelAdmin() {
        return signedIn() && (masjidDoc().ownerUid == request.auth.uid
          || channelRole() == 'admin' || isAdmin());
      }
      function canPost() { return isChannelAdmin() || channelRole() == 'editor'; }

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isChannelAdmin());
        // Join yourself, as a plain member, an approved masjid's channel.
        allow create: if signedIn() && request.auth.uid == uid
          && masjidDoc().status == 'approved'
          && request.resource.data.keys().hasOnly(
               ['uid', 'masjidId', 'masjidName', 'name', 'role', 'joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.masjidId == masjidId
          && request.resource.data.role == 'member';
        // Only the role changes, and only by an admin.
        allow update: if isChannelAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['member', 'editor', 'admin'];
        // Leave yourself, or be removed by an admin.
        allow delete: if signedIn() && (request.auth.uid == uid || isChannelAdmin());
      }

      match /messages/{messageId} {
        allow read: if isChannelAdmin() || channelRole() != '';
        allow create: if canPost()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.masjidId == masjidId
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          // Text, an attachment, or both.
          && (request.resource.data.text.size() > 0
              || request.resource.data.get('attachment', null) != null);
        allow delete: if isChannelAdmin()
          || (signedIn() && resource.data.authorUid == request.auth.uid);

        // Attachment bytes, ~900 KB per chunk (no paid file storage).
        match /chunks/{i} {
          allow read: if isChannelAdmin() || channelRole() != '';
          allow create: if canPost()
            && request.resource.data.keys().hasOnly(['b'])
            && request.resource.data.b is bytes
            && request.resource.data.b.size() <= 1000000;
          allow delete: if canPost();
        }
      }
    }

    // Admin report: every edit and every editor, across masjids.
    match /{path=**}/edits/{editId} {
      allow read: if isAdmin();
    }
    // Admin website: channel messages across all masjids (moderation).
    match /{path=**}/messages/{messageId} {
      allow read: if isAdmin();
    }
    match /{path=**}/editors/{uid} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Masjids missing from the app, pinned by users; the admin adds them.
    match /suggestions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['name', 'nameBn', 'lat', 'lng', 'district', 'thana', 'country', 'uid',
              'userName', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 80
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
      allow update, delete: if isAdmin();
    }

    // Problems reported by users ("wrong jamat time"…): one per user and
    // masjid (id = masjidId_uid); only the admin reads and resolves them.
    match /reports/{reportId} {
      function validReport() {
        return signedIn()
          && reportId == request.resource.data.masjidId + '_' + request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.keys().hasOnly(
               ['masjidId', 'masjidName', 'district', 'uid', 'userName', 'reason',
                'note', 'status', 'createdAt'])
          && request.resource.data.reason in
               ['wrongTime', 'wrongLocation', 'wrongInfo', 'closed', 'duplicate', 'other']
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500;
      }
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if validReport();
      // Reporting again replaces your own report (and reopens it).
      allow update: if validReport() || isAdmin();
      allow delete: if isAdmin();
    }

    // "My channels": a user can list their own memberships across masjids.
    match /{path=**}/members/{uid} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // App news for everyone (update announcements) – written by the admin
    // (website) and the admin tools (firebase/tools/broadcast.mjs).
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Admin website (docs/admin) --------------------------------------
    // App-wide switches: minimum version, maintenance banner. Everyone reads.
    match /config/{id} {
      allow read: if true;
      // App switches: super admins. Place names (config/places): any admin.
      // Admins saving content only move its version (contentVersion).
      allow write: if isSuperAdmin() || (id == 'places' && isAdmin());
      allow update: if id == 'app' && isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['contentVersion', 'updatedAt']);
      allow create: if id == 'app' && isAdmin()
        && request.resource.data.keys().hasOnly(['contentVersion', 'updatedAt']);
    }

    // Content the admins correct (refresh ayat, Home verses, duas, dhikr);
    // the app has the same built in and reads these only when changed.
    match /content/{set} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Work that needs the Admin SDK (push, disable / delete accounts): the
    // admin queues it, the GitHub job (firebase/tools/admin_jobs.mjs) runs it
    // and records the result.
    match /adminJobs/{id} {
      allow read, create: if isAdmin();
    }
    // Masjid numbers: counters/masjid.next is the next number to give
    // (when an admin approves a masjid).
    match /counters/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Who did what in the admin website. Never edited or deleted.
    match /adminLog/{id} {
      allow read, create: if isAdmin();
    }

    match /notices/{noticeId} {
      function masjid(id) { return get(/databases/$(database)/documents/masjids/$(id)).data; }

      allow read: if true;
      allow create: if signedIn()
        && masjid(request.resource.data.masjidId).ownerUid == request.auth.uid
        && masjid(request.resource.data.masjidId).status == 'approved'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      allow update, delete: if (signedIn()
          && masjid(resource.data.masjidId).ownerUid == request.auth.uid)
        || isAdmin();
    }
  }
}
